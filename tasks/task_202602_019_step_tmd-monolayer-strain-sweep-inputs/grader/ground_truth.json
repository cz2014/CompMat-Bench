  "reference_provenance": "reference/POSCAR_<layer>_eps_<tag>.vasp symlinks our as-shipped strained-monolayer POSCAR of that layer and strain (3_reproduction/L6/references/). BOTH the _relax and the _static label of a tag are graded against the same reference (the static POSCAR carries the built strained geometry: the relaxed CONTCAR is not available when the inputs are written).",
  "structure_match": {
    "max_disp_A": 0.1,
    "method": "matcher",
    "note": "1H TMD monolayer has no polar sublattice-swap ambiguity (the two chalcogens share the in-plane site and species), so the default StructureMatcher is safe. The strain skill is enforced by the independent lattice check inside match_structure (rel=1e-3, i.e. 0.1% on each cell length): a wrong-sign or wrong-magnitude strain shifts the in-plane length by >=0.5% (the sweep step) and fails cleanly; verified in selfcheck_variants.py."
  },
  "min_vacuum_A": 15.0,
  "kmesh_reference": {
    "subdivisions": [
      18,
      18,
      1
    ],
    "vacuum_axes": [
      2
    ],
    "note": "As-run reproduction mesh provenance. Grading uses the separate frozen kmesh_policy; centering and vacuum requirements remain independent."
  },
  "incar_required_static": {
    "note": "Each rule applies to the effective value: the tag if explicitly set, else the VASP default. Only the settings listed here are graded; the per-tag reasoning is in notes.md.",
    "LSORBIT_true": "LSORBIT=.TRUE. (spin-orbit coupling on; the band spin-splitting at K is the graded output; no usable default, REQUIRED-explicit)",
    "static": "NSW effectively 0 or IBRION=-1 (no ionic motion; default NSW 0)",
    "ENCUT_floor": "ENCUT >= the largest ENMAX over species present (280 eV for WS2, 223 eV for WSe2; catalog-based benchmark grading floor)",
    "ISMEAR_set": "ISMEAR in {-5, 0} (semiconductor; default 1)",
    "EDIFF_floor": "EDIFF <= 1e-5 eV (ours 1e-6; default 1e-4)",
    "functional": "PBE: GGA absent or GGA=Pe",
    "kmesh": "Frozen automatic-default minima from kmesh_policy, with the separately specified centering, vacuum and method constraints.",
    "poscar_species": "W1 + S2 (WS2) or W1 + Se2 (WSe2)",
    "poscar_vacuum": "vacuum along z >= 15 A (sanity; the built cells carry 20 A)"
  },
  "incar_required_relax": {
    "note": "From the Step-A spec in task.txt (decision D3).",
    "relax_fixed_cell": "ISIF effectively in {0,1,2} (fixed cell; default 2), IBRION in {1,2,3}, force-based EDIFFG<0 with |EDIFFG|<=0.05 eV/A",
    "NSW_ge_1": "NSW >= 1 explicit (an ionic relaxation must take steps; default 0 fails)",
    "ENCUT_floor": "ENCUT >= the largest ENMAX over species present (same floor as static)",
    "ISMEAR_set": "ISMEAR in {-5, 0}",
    "EDIFF_floor": "EDIFF <= 1e-5 eV (task.txt Step A: 1E-5)",
    "functional": "PBE: GGA absent or GGA=Pe",
    "kmesh": "Frozen automatic-default minima from kmesh_policy, with the separately specified centering, vacuum and method constraints.",
    "poscar_species": "same as static",
    "poscar_vacuum": "same as static"
  },
  "not_required_recorded": {
    "ISYM": "Not graded for this nonmagnetic zero-field SOC task. VASP recommends checking sensitivity to symmetry, not universally disabling it; default 2 and explicit -1/0 remain accepted. The actual K point is checked independently.",
    "LVHAR": "NOT required. The downstream graded convention (L6_analyze) references the K band edges to the LOCAL W 5p semicore level read from the eigenvalue spectrum, not to a LOCPOT/vacuum plateau; LVHAR only writes the Hartree potential to LOCPOT, which the graded analysis does not consume. Our as-run statics set LVHAR=.TRUE. because the reproduction also kept an alternative vacuum-referenced cross-check, but it is not physics-essential to the graded quantity.",
    "IVDW": "NOT listed. An isolated monolayer has no interlayer van der Waals bond; the as-run INCARs carry no IVDW (default 0). REQUIRING a vdW correction here would be wrong.",
    "ISPIN": "NOT required. The monolayers are non-magnetic and the run is noncollinear (LSORBIT=.TRUE.), so ISPIN does not change the eigenvalues; ISPIN=1 is a memory choice (task.txt sets it to avoid the 2x spinor-doubling waste), not result-affecting. Recorded, not graded.",
    "KPAR_NCORE_ALGO_NELM_PREC_LREAL_LWAVE_LCHARG": "Outside the present bounded rubric. Their as-run values alone do not establish necessity; ungraded does not imply that every possible value preserves the result."
  },
  "score": "1 only if all 28 runs pass their structure match AND their run-type REQUIRED INCAR/KPOINTS rubric (all checks must pass; any single failure scores 0)",
