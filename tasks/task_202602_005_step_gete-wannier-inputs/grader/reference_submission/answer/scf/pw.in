&control
    calculation      = 'scf'
    prefix           = 'gete'
    outdir           = './out'
    pseudo_dir       = '/home/user/pp/sg15'
    verbosity        = 'high'
/
&system
    ibrav            = 0
    nat              = 2
    ntyp             = 2
