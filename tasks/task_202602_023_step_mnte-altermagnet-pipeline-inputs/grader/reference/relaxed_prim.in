&control
    calculation      = 'scf'
    prefix           = 'mnte_prim'
    outdir           = './out'
    pseudo_dir       = '/scratch/user/codes_data/qe/pseudo'
    verbosity        = 'high'
/
&system
    ibrav            = 0
    nat              = 4
    ntyp             = 3
    ecutwfc          = 60
    ecutrho          = 480
    occupations      = 'smearing'
    smearing         = 'gaussian'
    degauss          = 0.01
    nspin            = 2
    starting_magnetization(1) =  0.6
    starting_magnetization(2) = -0.6
    starting_magnetization(3) =  0.0
/
&electrons
    conv_thr         = 1.0d-9
    electron_maxstep = 200
/
