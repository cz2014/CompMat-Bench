  "structure_match": {
    "max_disp_A": 0.1,
    "method": "fallback",
    "note": "translation-only, polarity-safe: the flat hBN bilayer has a sublattice-swapping symmetry that StructureMatcher (method='matcher') absorbs, so a B/N swap (reversed polarization) would wrongly pass. The fallback method (rigid-translation scan + nearest-same-species, no symmetry ops) fails the swap; verified in the self-check."
  },
  "incar_required": {
    "current_rules": "L1 fixed-geometry static inputs: charge-updating ICHARG and any required charge/potential initialization file; ionic + Hartree OR total local potential output through LVHAR, LVTOT or WRT_POTENTIAL; LDIPOL true and IDIPOL 3; explicit ENCUT >= 400 eV; ISMEAR in {-5,-1,0}; 0 < EDIFF <= 1e-5 eV; same accepted PBE functional throughout. No empirical dispersion requirement or Hubbard U/J interception. Gamma and Monkhorst-Pack automatic meshes allowed, at least 10 x 5 x 1, exactly one subdivision along z. See notes.md and bundled grader rules."
  },
  "kmesh_reference": {
    "subdivisions": [
      15,
      9,
      1
    ],
    "vacuum_axes": [
      2
    ],
    "note": "As-run reproduction mesh provenance. Grading uses the separate frozen kmesh_policy; centering and vacuum requirements remain independent."
  },
  "score": "1 only if all 12 runs pass structure match AND the INCAR/KPOINTS REQUIRED rubric (all checks must pass; any single failure scores 0)",
