create:full
create:periodic-boundaries-x
create:periodic-boundaries-y
create:periodic-boundaries-z
material:file = material.mat
material:unit-cell-file = unitcell.ucf
dimensions:unit-cell-size-x = 5.775871 !A
dimensions:unit-cell-size-y = 2.965491 !A
dimensions:unit-cell-size-z = 4.143072 !A
dimensions:system-size-x = 57.75871000000001 !A
dimensions:system-size-y = 59.30982 !A
dimensions:system-size-z = 58.003008 !A
sim:integrator = monte-carlo
