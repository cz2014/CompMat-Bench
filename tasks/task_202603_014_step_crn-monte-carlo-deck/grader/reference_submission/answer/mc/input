sim:minimum-temperature = 0.0
sim:maximum-temperature = 350.0
sim:temperature-increment = 5.0
sim:equilibration-time-steps = 5000
sim:loop-time-steps = 15000
sim:time-steps-increment = 1
output:temperature
output:material-mean-magnetisation-length
output:material-mean-magnetisation
output:material-mean-susceptibility
output:mean-specific-heat
output:mean-exchange-energy
output:mean-total-energy
output:column-headers = true
